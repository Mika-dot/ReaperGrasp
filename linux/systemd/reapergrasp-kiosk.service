[Unit]
Description=ReaperGrasp fullscreen operator display
After=systemd-user-sessions.service reapergrasp.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
User=reapergrasp
Group=reapergrasp
SupplementaryGroups=video render input
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
RuntimeDirectory=reapergrasp-kiosk
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/reapergrasp-kiosk
Environment=XDG_SESSION_TYPE=wayland
Environment=HOME=/var/lib/reapergrasp
ExecStart=/opt/reapergrasp/linux/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
